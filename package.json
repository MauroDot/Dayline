{
  "name": "dayline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && node --check public/app.js && node --check public/stories.js && node --check public/edition.js && node --check public/source-queue.js && node --check internal/operations/operations.js && npm test",
    "typecheck": "tsc --noEmit",
    "ingest:fixture": "node --experimental-strip-types src/ingestion/runner.ts",
    "source-queue:fixture": "node --experimental-strip-types src/source-queue/runner.ts",
    "source-access:fixture": "node --experimental-strip-types src/security/source-runner.ts",
    "source-review:fixture": "node --experimental-strip-types src/security/source-review-runner.ts",
    "editorial-workflow:fixture": "node --experimental-strip-types src/security/editorial-workflow-runner.ts",
    "editorial-operations:dev": "node --experimental-strip-types src/security/operations-runner.ts --fictional",
    "editorial-operations:fixture": "node --experimental-strip-types src/security/operations-runner.ts --fictional --demo",
    "retention:fixture": "node --experimental-strip-types src/ingestion/cleanup-runner.ts",
    "edition:fixture": "node --experimental-strip-types src/editions/runner.ts",
    "schedule:fixture": "node --experimental-strip-types src/scheduling/runner.ts",
    "build:public": "node --experimental-strip-types scripts/build-public.ts",
    "inspect:public": "node --experimental-strip-types scripts/inspect-public.ts",
    "start:public": "node --experimental-strip-types dist/public-reader/src/public/main.ts",
    "smoke:public": "node --experimental-strip-types scripts/smoke-public.ts",
    "check:staging-release": "node --experimental-strip-types scripts/check-staging-release.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
