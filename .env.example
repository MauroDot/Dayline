# Public-reader example only. This file is not automatically loaded.
# Never commit actual contact details, credentials or production environment files.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Required in staging/production; if set in development it must also be valid.
# Enter an application identifier and the owner's real contact privately in process settings.
# The example below is intentionally rejected; replace it outside Git.
# NWS_USER_AGENT=Dayline/0.1 (your-contact@example.com)

# Optional public origin; HTTPS required outside development.
# No credentials, path, query or fragment.
# PUBLIC_BASE_URL=https://reader.example.invalid

UPSTREAM_TIMEOUT_MS=8000
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=5000
MAX_CONNECTIONS=128
MAX_CONCURRENT_REQUESTS=32

# LOCAL SOURCE-CHECKOUT fictional edition only; absent from the release artifact.
# The default HOST stays loopback. Staging/production reject development flags.
# DAYLINE_DEV_EDITION=fictional

# Staging/production may explicitly select HOST=0.0.0.0 only for a separately
# reviewed platform/proxy topology. This example does not open a firewall port.
# Do not place synthetic bearer/provider, editorial, AI, payment or database
# configuration in the public-reader environment.
